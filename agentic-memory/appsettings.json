{
  "Server": {
    "_comment": "ApiKey is empty by default, which means no authentication. Set it to any string to require that key on every /api and /mcp request, sent as the ApiKeyHeader below or as 'Authorization: Bearer <key>'. /api/admin/health stays open so a host process can wait for startup. The AGENTIC_MEMORY_API_KEY environment variable overrides this. Set a key whenever BindAddress is not loopback.",
    "Port": 3377,
    "BindAddress": "0.0.0.0",
    "ApiKey": "",
    "ApiKeyHeader": "X-API-Key"
  },
  "Storage": {
    "_comment": "Paths are empty on purpose. The database goes to the per-user data folder for this platform, which survives an app update; model weights stay beside the program, shipped with the build. Override with --data-dir / --models-dir or AGENTIC_MEMORY_DATA_DIR / AGENTIC_MEMORY_MODELS_DIR. A relative value here resolves against the matching folder; an absolute value is used as given.",
    "DataDirectory": "",
    "ModelsDirectory": "",
    "DatabasePath": "",
    "MaxContentSizeBytes": 524288,
    "MaxTitleLength": 500,
    "MaxSummaryLength": 2000,
    "MaxTagsPerMemory": 20
  },
  "Embeddings": {
    "Enabled": true,
    "ModelsPath": "",
    "AutoDownload": true,
    "ModelUrlOnnx": "https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/onnx/model.onnx",
    "ModelVocabUrlTxt": "https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/vocab.txt",
    "ModelFileName": "all-MiniLM-L6-v2.onnx",
    "VocabFileName": "vocab.txt",
    "ModelDimensions": 384,
    "MaxSequenceLength": 256
  },
  "Generation": {
    "Enabled": false,
    "ModelsPath": "",
    "AutoDownload": true,
    "RepoBaseUrl": "https://huggingface.co/microsoft/Phi-4-mini-instruct-onnx/resolve/a64b5309e58f6ac22cacdf9d143ab7455d8b9f5b/cpu_and_mobile/cpu-int4-rtn-block-32-acc-level-4",
    "Files": [
      {
        "FileName": "genai_config.json",
        "ExpectedBytes": 1520
      },
      {
        "FileName": "config.json",
        "ExpectedBytes": 2500
      },
      {
        "FileName": "configuration_phi3.py",
        "ExpectedBytes": 10900
      },
      {
        "FileName": "tokenizer.json",
        "ExpectedBytes": 15500000
      },
      {
        "FileName": "tokenizer_config.json",
        "ExpectedBytes": 2960
      },
      {
        "FileName": "vocab.json",
        "ExpectedBytes": 3910000
      },
      {
        "FileName": "merges.txt",
        "ExpectedBytes": 2420000
      },
      {
        "FileName": "added_tokens.json",
        "ExpectedBytes": 249
      },
      {
        "FileName": "special_tokens_map.json",
        "ExpectedBytes": 587
      },
      {
        "FileName": "model.onnx",
        "ExpectedBytes": 52100000
      },
      {
        "FileName": "model.onnx.data",
        "ExpectedBytes": 4860000000
      }
    ],
    "MaxNewTokens": 512,
    "Temperature": 0.7,
    "TopP": 0.9
  },
  "Maintenance": {
    "Enabled": true,
    "DecayEnabled": true,
    "DecayIntervalHours": 24,
    "ArchiveEpisodicAfterDays": 180,
    "PurgeForgottenAfterDays": 30,
    "ConsolidationEnabled": true,
    "ConsolidationIntervalHours": 24,
    "SimilarityThreshold": 0.9,
    "InitialDelayMinutes": 5,
    "BackupBeforeDestructiveOperations": true,
    "BackupPath": "",
    "BackupRetentionCount": 10
  },
  "Conflict": {
    "DuplicateSimilarityThreshold": 0.92,
    "CandidateSimilarityThreshold": 0.55,
    "MaxCandidates": 25,
    "AutoSupersedeEnabled": true
  },
  "Retrieval": {
    "MinSemanticSimilarity": 0.25,
    "MinTopSemanticZScore": 3.2,
    "MinTopSemanticZScoreForKnownTerms": 2.0,
    "MinSemanticZScore": 1.0,
    "MinSamplesForSemanticDistribution": 10,
    "MinLexicalScore": 0.08,
    "MinTrigramSimilarity": 0.4,
    "MaxCandidatesPerChannel": 200,
    "VectorChannelWeight": 1.0,
    "LexicalChannelWeight": 1.0,
    "SlotChannelWeight": 1.25,
    "RecencyChannelWeight": 0.4,
    "LinkChannelWeight": 0.3,
    "DiversityLambda": 0.75,
    "ReinforceOnRead": true
  },
  "CodeIndex": {
    "Enabled": true,
    "EnableCSharpRoslyn": true,
    "EnableTypeScriptV8": true,
    "AutoDownloadTypeScript": true,
    "TypeScriptVersion": "5.5.4",
    "TypeScriptModelsPath": "",
    "TypeScriptCompilerPath": null,
    "ProjectRoots": [],
